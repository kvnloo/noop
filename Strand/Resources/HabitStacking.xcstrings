    "Choose a cue and a tiny action. Save as a Journal question, then mark Yes or No yourself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a cue and a tiny action. Save as a Journal question, then mark Yes or No yourself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Auslöser und eine kleine Handlung. Speichere sie als Journal-Frage und antworte selbst mit Ja oder Nein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una señal y una acción pequeña. Guárdalas como pregunta del diario y responde Sí o No cuando corresponda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un déclencheur et une petite action. Ajoutez-les comme question au journal, puis répondez vous-même par oui ou non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un segnale e una piccola azione. Salvali come domanda nel diario, poi rispondi personalmente Sì o No."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um sinal e uma ação pequena. Guarde-os como pergunta no diário e responda Sim ou Não."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz sygnał i drobne działanie. Zapisz je jako pytanie w dzienniku, a następnie samodzielnie zaznacz Tak lub Nie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите сигнал и небольшое действие. Сохраните их как вопрос в дневнике, затем самостоятельно отметьте «Да» или «Нет»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个提示和一个微小行动。将其保存为日志问题，然后自行选择“是”或“否”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個提示和一項微小行動。將其儲存為日誌問題，再自行選擇「是」或「否」。"
          }
        }
      }
    },
