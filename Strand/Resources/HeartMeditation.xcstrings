    "Breathe slowly and watch the level follow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe slowly and watch the level follow"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atme langsam und sieh zu, wie der Pegel folgt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira despacio y mira cómo el nivel te sigue"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respirez lentement et regardez le niveau suivre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira lentamente e guarda il livello seguirti"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddychaj powoli i patrz, jak poziom podąża"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Respire devagar e veja o nível acompanhar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дышите медленно и следите, как уровень следует за вами"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢呼吸，看液面跟随你"
          }
        }
      }
    },
