    "Estimates from optical beat timing, with noisy beats skipped. They only mean something while you are still, and they are not a medical reading.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates from optical beat timing, with noisy beats skipped. They only mean something while you are still, and they are not a medical reading."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzungen aus optischem Herzschlag-Timing, verrauschte Schläge werden übersprungen. Sie sind nur im Stillsitzen aussagekräftig und keine medizinische Messung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimaciones a partir del ritmo óptico de los latidos, omitiendo los ruidosos. Solo tienen sentido si estás quieto y no son una medición médica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimations issues du rythme optique des battements, battements bruités ignorés. Elles n'ont de sens qu'au repos immobile et ne sont pas une mesure médicale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stime dal ritmo ottico dei battiti, saltando quelli rumorosi. Hanno senso solo stando fermi e non sono una misura medica."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunki z optycznego pomiaru odstępów między uderzeniami, zakłócone uderzenia są pomijane. Mają sens tylko w bezruchu i nie są pomiarem medycznym."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimativas a partir do ritmo ótico dos batimentos, ignorando os ruidosos. Só fazem sentido quando está quieto e não são uma medição médica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценки по оптическим интервалам между ударами, зашумлённые удары пропускаются. Имеют смысл только в покое и не являются медицинским измерением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于光学心跳间期的估算，已跳过有噪声的心跳。仅在静止时有意义，且不是医疗测量。"
          }
        }
      }
    },
    "Tap the heart for a beat-synced meditation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the heart for a beat-synced meditation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Herz für eine herzschlag-synchrone Meditation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el corazón para una meditación sincronizada con tus latidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cœur pour une méditation synchronisée sur vos battements"
          }
        },
        "it": {
