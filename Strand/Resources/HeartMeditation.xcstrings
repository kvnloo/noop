{
  "sourceLanguage": "en",
  "strings": {
    "Heart meditation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart meditation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herz-Meditation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meditación del corazón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Méditation cardiaque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meditazione del cuore"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medytacja serca"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Meditação do coração"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медитация сердца"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心跳冥想"
          }
        }
      }
    },
    "Each ripple is one of your heartbeats. The level rises and falls with the wave your breathing puts into your heart rate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each ripple is one of your heartbeats. The level rises and falls with the wave your breathing puts into your heart rate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Welle ist einer deiner Herzschläge. Der Pegel steigt und fällt mit der Welle, die deine Atmung in deinen Puls legt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada onda es uno de tus latidos. El nivel sube y baja con la onda que tu respiración imprime en tu frecuencia cardíaca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque onde est l'un de vos battements. Le niveau monte et descend avec l'onde que votre respiration imprime à votre fréquence cardiaque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni increspatura è uno dei tuoi battiti. Il livello sale e scende con l'onda che il respiro imprime alla frequenza cardiaca."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda fala to jedno uderzenie twojego serca. Poziom rośnie i opada z falą, którą oddech wprowadza do tętna."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ondulação é um dos seus batimentos. O nível sobe e desce com a onda que a respiração imprime no seu ritmo cardíaco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая волна — один удар вашего сердца. Уровень поднимается и опускается вместе с волной, которую дыхание вносит в пульс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一道涟漪都是你的一次心跳。液面随呼吸带给心率的波动而起伏。"
          }
        }
      }
    },
    "Close heart meditation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close heart meditation"
          }
        },
        "de": {
