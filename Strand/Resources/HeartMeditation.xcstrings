        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar meditação do coração"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть медитацию сердца"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭心跳冥想"
          }
        }
      }
    },
    "Waiting for steady beats": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for steady beats"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf gleichmäßige Schläge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando latidos estables"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de battements réguliers"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di battiti regolari"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekam na równe uderzenia"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À espera de batimentos estáveis"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём ровных ударов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待稳定的心跳"
          }
        }
      }
    },
    "Sit still with the ring snug. The view starts once a few clean beats agree.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit still with the ring snug. The view starts once a few clean beats agree."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitz still, der Ring sitzt fest. Die Ansicht startet, sobald einige saubere Schläge übereinstimmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédate quieto con el anillo ajustado. La vista empieza cuando varios latidos limpios coinciden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez immobile, la bague bien ajustée. La vue démarre dès que quelques battements propres concordent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta fermo con l'anello ben aderente. La vista parte quando alcuni battiti puliti concordano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siedź nieruchomo z dobrze dopasowanym pierścieniem. Widok startuje, gdy kilka czystych uderzeń będzie zgodnych."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique quieto com o anel bem ajustado. A vista começa quando alguns batimentos limpos concordam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сидите неподвижно, кольцо должно плотно сидеть. Вид запустится, когда несколько чистых ударов совпадут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持静止并戴紧戒指。几次干净的心跳一致后即开始。"
          }
        }
      }
    },
